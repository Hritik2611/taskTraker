<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Update Task</title>
  <link rel="stylesheet" href="/style.css" />
</head>

<body>
  <%- include('navbar') %>

    <div class="container">
      <h1>Update Existing Task</h1>

      <form action="/update/<%= result._id %>" class="todo-form" method="post">
        <input value="<%= result.title %>" type="text" name="title" class="input" placeholder="Enter Task title" />
        <br />
        <br />
        <textarea name="description" id="" class="input"><%= result.description %>
        </textarea>
        <br />
        <br />
        <button class="btn">Update Task</button>
      </form>
    </div>
</body>

</html>